# Ark_AI local configuration template.
# Copy this to .env and fill in values, or just run install_ark_ai.bat
# (Windows) which generates a real .env automatically. Never commit a
# real .env file - it holds secrets.

# Required: signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ARK_AI_SECRET_KEY=

# 127.0.0.1 = localhost only (recommended). 0.0.0.0 = network exposed,
# which requires ARK_AI_TOKEN to be set below.
ARK_AI_HOST=127.0.0.1
ARK_AI_PORT=5000

# Only required when ARK_AI_HOST is not loopback. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# ARK_AI_TOKEN=

# Leave unset to use the default SQLite file (ark_ai.db). Set to a
# postgresql:// URL to use PostgreSQL instead.
# DATABASE_URL=postgresql://user:pass@host:5432/ark_ai

# Instance-wide fallback OpenRouter key, used only when no key has been
# saved in Settings.
# OPENROUTER_API_KEY=

# --- Legacy fallback names (still read if the ARK_AI_* vars above are
# unset, so existing installs keep working): RELAY_SECRET_KEY,
# RELAY_HOST, RELAY_PORT, RELAY_TOKEN, RELAY_DB_PATH.
